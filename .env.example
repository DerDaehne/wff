# Kopieren nach .env und anpassen — von docker-compose.yml gelesen.

POSTGRES_USER=wff
POSTGRES_PASSWORD=wff
POSTGRES_DB=wff
POSTGRES_PORT=5432
APP_PORT=8080

# ERFORDERLICH — kein sicherer Default möglich. Muss exakt dem echten
# öffentlichen Origin entsprechen, sonst lehnt der Browser jede
# Passkey-Ceremony ab (siehe arch-wff-auth). Für lokales Testen ohne
# eigene Domain: WEBAUTHN_RPID=localhost, WEBAUTHN_ORIGIN=http://localhost:8080,
# COOKIE_SECURE=false (Session-Cookies brauchen sonst HTTPS).
WEBAUTHN_RPID=wff.example.com
WEBAUTHN_ORIGIN=https://wff.example.com
# COOKIE_SECURE=false

# Optional — sinnvolle Defaults im Code, nur bei Bedarf überschreiben.
# ENRICHMENT_POLL_INTERVAL=1h
# OPENMETEO_BASE_URL=
